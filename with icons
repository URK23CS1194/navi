        padding: EdgeInsets.all(15),

        child: Column(
          children: [

            Text(
              "Available Products",
              style: TextStyle(
                fontSize: 24,
                fontWeight: FontWeight.bold,
              ),
            ),

            SizedBox(height: 20),

            Card(
              child: ListTile(
                title: Text("Notebook"),
                subtitle: Text("Rs.50"),
              ),
            ),

            Card(
              child: ListTile(
                title: Text("Pen"),
                subtitle: Text("Rs.10"),
              ),
            ),

            Card(
              child: ListTile(
                title: Text("Pencil"),
                subtitle: Text("Rs.5"),
              ),
            ),

            SizedBox(height: 25),

            ElevatedButton(
              style: ElevatedButton.styleFrom(
                backgroundColor: Colors.blue,
                foregroundColor: Colors.white,
                padding: EdgeInsets.symmetric(
                  horizontal: 40,
                  vertical: 15,
                ),
              ),

              child: Text("Back"),

              onPressed: () {
                Navigator.pop(context);
              },
            ),

          ],
        ),
      ),
    );
